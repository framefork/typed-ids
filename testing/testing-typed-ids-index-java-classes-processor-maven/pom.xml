<?xml version="1.0" encoding="UTF-8"?>
<!--
	A plain Maven project that checks the typed-ids index processor in a real Maven build, wired the way the README tells Maven users to.
	It has no build.gradle.kts, so the Gradle build does not include it. Run it through run-maven-index-check.sh, which tests both wirings and the partial compiles.

	The typed-ids version comes from the command line: -Dtyped-ids.version=..., after ./gradlew publishToMavenLocal -Pversion=... in the repository root.
	Activate exactly one of the profiles: processor-path or classpath-discovery.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.example</groupId>
	<artifactId>typed-ids-index-java-classes-processor-maven</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>17</maven.compiler.release>

		<junit-jupiter.version>5.14.4</junit-jupiter.version>
		<maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
		<maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
		<maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
		<maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
		<maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.framefork</groupId>
			<artifactId>typed-ids</artifactId>
			<version>${typed-ids.version}</version>
		</dependency>


		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit-jupiter.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-clean-plugin</artifactId>
					<version>${maven-clean-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-resources-plugin</artifactId>
					<version>${maven-resources-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${maven-compiler-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>${maven-surefire-plugin.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>${maven-enforcer-plugin.version}</version>
				<executions>
					<execution>
						<id>require-typed-ids-version-and-wiring</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireProperty>
									<property>typed-ids.version</property>
									<message>Pass the typed-ids version under test: -Dtyped-ids.version=...</message>
								</requireProperty>
								<requireProperty>
									<property>index-processor.wiring</property>
									<message>Activate exactly one profile: -Pprocessor-path or -Pclasspath-discovery</message>
								</requireProperty>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- The README's "register the processor explicitly" variant. -->
		<profile>
			<id>processor-path</id>
			<properties>
				<index-processor.wiring>processor-path</index-processor.wiring>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-compiler-plugin</artifactId>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.framefork</groupId>
									<artifactId>typed-ids-index-java-classes-processor</artifactId>
									<version>${typed-ids.version}</version>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- The README's optional dependency variant, which needs proc=full because JDK 23+ javac skips processors discovered on the classpath by default. -->
		<profile>
			<id>classpath-discovery</id>
			<properties>
				<index-processor.wiring>classpath-discovery</index-processor.wiring>
			</properties>
			<dependencies>
				<dependency>
					<groupId>org.framefork</groupId>
					<artifactId>typed-ids-index-java-classes-processor</artifactId>
					<version>${typed-ids.version}</version>
					<optional>true</optional>
				</dependency>
			</dependencies>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-compiler-plugin</artifactId>
						<configuration>
							<proc>full</proc>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
